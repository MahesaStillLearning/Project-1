import pygame
import sys
import random

running = True

import pygame
x = 150
y = 50
w = 30
h = 30
sw = 600
sh = 400
velocity = 0
gravitasi = 0.3
kekuatan = -7
game_over = False


pw = 60
pg = 150
ps = 3

pp = []
def ppipa():
    ph = random.randint(50, sh - pg - 50)

    pa = pygame.Rect(sw, 0, pw, ph)
    pb = pygame.Rect(sw, ph + pg, pw, sh - (ph + pg))

    return pa, pb

pygame.init()
screen = pygame.display.set_mode((sw, sh))
pygame.display.set_caption("Kotak Kuning")
clock = pygame.time.Clock()

font = pygame.font.SysFont(None, 50)
pipa_timer = 0
running = True
while running:
    
    screen.fill((135, 206, 235))  # warna langit biru
    pygame.draw.rect(screen, (255, 255, 0), (x, y, w, h))
    pygame.display.flip()
    
    pipa_timer += 1
    
    if pipa_timer > 120:
        pp.append(ppipa())
        pipa_timer = 0
    
    for pipa in pp:
        pipa[0].x -= ps
        pipa[1].x -= ps
        
    for pipa in pp:
        pygame.draw.rect(screen, (0, 200, 0), pipa[0])
        pygame.draw.rect(screen, (0, 200, 0), pipa[1])
    
    if not game_over:
        velocity += gravitasi
        y += velocity
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
            
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE:
                velocity = kekuatan
    
    if y >= 370:
        game_over = True
    
    if game_over:
        text = font.render("Game Over!", True, (255,0,0))
        screen.blit(text, (120, 250))
    
    pygame.display.update()
    clock.tick(60)
